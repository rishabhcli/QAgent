{
  "name": "@qagent/desktop",
  "productName": "QAgent",
  "description": "Local-first autonomous QA for web applications",
  "license": "AGPL-3.0",
  "version": "0.2.0-beta.1",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "build:worker": "tsup --config tsup.config.ts",
