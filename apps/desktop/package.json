    "@fontsource-variable/source-sans-3": "5.3.0",
    "@qagent/adapters": "workspace:*",
    "@qagent/contracts": "workspace:*",
    "@qagent/core": "workspace:*",
    "@qagent/storage": "workspace:*",
    "better-sqlite3": "13.0.1",
    "electron-squirrel-startup": "1.0.1",
    "lucide-react": "1.25.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "update-electron-app": "3.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
