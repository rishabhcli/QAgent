    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "43.2.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
