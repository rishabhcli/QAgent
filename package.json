{
  "name": "qagent",
  "version": "0.2.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Local-first autonomous QA for web applications",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @qagent/desktop dev",
    "dev:docs": "pnpm --filter @qagent/docs dev",
    "build": "pnpm build:packages && pnpm --filter @qagent/desktop build && pnpm --filter @qagent/docs build",
    "build:packages": "pnpm --filter './packages/**' --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema": "tsx scripts/generate-schema.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:adapters": "tsx --conditions=qagent-source scripts/adapter-smoke.ts",
    "test:coverage": "vitest run --coverage",
    "e2e:prepare": "pnpm build:packages && pnpm --filter @qagent/desktop build",
    "test:e2e": "pnpm e2e:prepare && playwright test",
    "package": "pnpm build:packages && pnpm --filter @qagent/desktop make",
    "qagent": "tsx --conditions=qagent-source packages/cli/src/bin.ts",
    "mcp": "tsx --conditions=qagent-source packages/mcp/src/bin.ts",
    "doctor": "pnpm qagent doctor",
    "security:audit": "pnpm audit --prod --audit-level high",
    "release:sbom": "pnpm sbom --sbom-format cyclonedx --prod --out release/qagent.cdx.json --sbom-type application --sbom-supplier 'QAgent contributors'",
    "release:collect": "tsx scripts/collect-release-artifacts.ts",
    "release:finalize": "tsx scripts/finalize-release.ts",
    "release:smoke-installed": "tsx scripts/smoke-packaged-app.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.4.0",
    "jsdom": "29.0.0",
    "prettier": "3.9.6",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
