{
  "name": "@qagent/adapters",
  "version": "0.2.0-beta.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "qagent-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@browserbasehq/stagehand": "3.7.0",
    "@google/genai": "2.28.0",
    "@octokit/rest": "22.0.1",
    "@puppeteer/browsers": "3.2.4",
    "@qagent/contracts": "workspace:*",
    "@qagent/storage": "workspace:*",
    "execa": "10.1.0",
    "openai": "6.48.0",
    "parse-diff": "0.12.0",
    "redis": "6.3.0",
    "weave": "0.16.9",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
