{
  "name": "@qagent/mcp",
  "version": "0.2.0-beta.1",
  "private": true,
  "type": "module",
  "bin": {
    "qagent-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "qagent-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean --external better-sqlite3",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@qagent/contracts": "workspace:*",
    "@qagent/core": "workspace:*",
    "@qagent/storage": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
