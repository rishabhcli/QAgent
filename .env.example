# QAgent runs locally without cloud infrastructure. Configure one model provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# OpenAI-compatible endpoints, including Ollama.
QAGENT_OPENAI_BASE_URL=
QAGENT_OPENAI_MODEL=

# Optional publication and cloud adapters.
GITHUB_TOKEN=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
WANDB_API_KEY=
WEAVE_PROJECT=qagent
REDIS_URL=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
DAYTONA_API_KEY=

# Optional local overrides.
QAGENT_HOME=
QAGENT_BROWSER_PATH=
QAGENT_LOG_LEVEL=info
